# Plantilla de variables de entorno.
#
# El archivo .env REAL no se commitea (está en .gitignore). Este ejemplo sí,
# para que quien clone el repo sepa qué variables necesita:
#
#     cp .env.example .env
#
# Después editá el .env con tus propios valores.

# Contraseña del PostgreSQL del compose
DB_PASSWORD=super-secreto-local

# Clave con la que se firman los tokens JWT (cambiala por algo largo y random)
JWT_SECRET=cambiame-por-un-secreto-largo-y-random

# Credenciales del usuario admin que se crea al arrancar por primera vez
ADMIN_EMAIL=admin@gamerate.local
ADMIN_PASSWORD=admin123
